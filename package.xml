<?xml version="1.0"?>
<package format="2">

  <name>pairs_uav_state_estimators</name>
  <version>1.0.0</version>
  <description>PAIRS UAV state estimator plugins — GPS/Garmin, GPS/Baro, RTK, Passthrough, GroundTruth</description>

  <maintainer email="canhthanh@vnu.edu.vn">Thanh Nguyen Canh</maintainer>

  <license>BSD 3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cmake_modules</depend>
  <depend>dynamic_reconfigure</depend>
  <depend>geometry_msgs</depend>
  <depend>message_generation</depend>
  <depend>message_runtime</depend>
  <depend>pairs_lib</depend>
  <depend>pairs_msgs</depend>
  <depend>pairs_uav_managers</depend>
  <depend>nav_msgs</depend>
  <depend>nodelet</depend>
  <depend>roscpp</depend>
  <depend>roslint</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>pairs_uav_testing</depend>

  <exec_depend>pluginlib</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>rostest</test_depend>

  <export>
    <pairs_uav_managers plugin="${prefix}/estimator_plugins.xml" />
  </export>

</package>
